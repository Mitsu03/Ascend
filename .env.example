# Configuração de visão embutida na build (opcional).
#
# Copiar para `.env.local` — que o git ignora — e preencher a chave. O valor
# entra como predefinição do painel Shinigami › Definições, para não ter de ser
# colado à mão em cada dispositivo onde a app é instalada.
#
# AVISO: qualquer variável VITE_* acaba dentro do bundle JavaScript, legível
# por quem tenha a app. Só para builds pessoais — nunca numa build para
# distribuir a testers pela TestFlight.
#
# Uma chave já guardada no dispositivo tem precedência: isto só preenche o que
# ainda está vazio.

VITE_VISION_API_KEY=
VITE_VISION_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
VITE_VISION_MODEL=gemini-3.5-flash-lite
